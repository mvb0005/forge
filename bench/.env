# Defaults for docker compose (and bench.sh). Override per run in the environment, e.g. SIM_REPLICAS=1 ./bench.sh up
# Eight sims at 1.5 cores each use about 8 of this machine's 16 cores and leave room for the other containers.
# For clean A/B timing numbers, prefer SIM_REPLICAS=1: AI decisions have a wall-clock cap, so CPU contention changes games.
SIM_REPLICAS=8
SIM_CPUS=1.5
JAVA_OPTS=-Xmx2g
