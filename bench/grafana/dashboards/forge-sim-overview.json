    {
      "id": 9,
      "type": "table",
      "title": "Winner by turn order",
      "description": "Each row is one seating of a pod, players listed in turn order (first player first), and who won it.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 10,
        "y": 5,
        "w": 14,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "round(sum by (forge_matchup, forge_outcome) (increase(forge_game_duration_seconds_count{service_version=~\"$version\",forge_scenario=~\"$scenario\",forge_pod=~\"$pod\",forge_matchup=~\"$matchup\"}[$__range]))) > 0",
          "legendFormat": "__auto",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "forge_matchup": 0,
              "forge_outcome": 1,
              "Value": 2
            },
            "renameByName": {
              "forge_matchup": "Turn order",
              "forge_outcome": "Winner",
              "Value": "Games"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Games"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Turn order"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 560
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Games",
            "desc": true
          }
        ]
      }
