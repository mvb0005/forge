      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(forge_game_turns_sum{service_version=~\"$version\",forge_scenario=~\"$scenario\",forge_pod=~\"$pod\",forge_matchup=~\"$matchup\"}[$__range])) / sum(increase(forge_game_turns_count{service_version=~\"$version\",forge_scenario=~\"$scenario\",forge_pod=~\"$pod\",forge_matchup=~\"$matchup\"}[$__range]))",
