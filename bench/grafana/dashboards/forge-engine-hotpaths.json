          "expr": "histogram_quantile(0.99, sum by (le, span_name, service_version) (increase(traces_span_metrics_duration_milliseconds_bucket{service_name=\"forge-sim\",service_version=~\"$version\",span_name=~\"$span\"}[$__range])))",
          "legendFormat": "__auto",
          "refId": "F",
          "instant": true,
          "range": false,
          "format": "table"
