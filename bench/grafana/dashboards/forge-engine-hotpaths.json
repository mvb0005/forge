      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "span_name": 0,
              "service_version": 1,
              "Value #A": 2,
              "Value #B": 3,
              "Value #C": 4,
              "Value #D": 5,
              "Value #E": 6,
              "Value #F": 7
            },
            "renameByName": {
              "span_name": "Span",
              "service_version": "Version",
              "Value #A": "Calls",
              "Value #B": "Total time",
              "Value #C": "Mean",
              "Value #D": "p50",
              "Value #E": "p95",
              "Value #F": "p99"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Total time"
