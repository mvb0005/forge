{
  "uid": "forge-engine-hotpaths",
  "title": "Forge engine hot paths",
  "description": "Every @WithSpan in the engine and AI, as call counts and latency (spanmetrics from all spans, unsampled).",
  "tags": [
    "forge"
  ],
  "editable": true,
  "schemaVersion": 39,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "version",
        "label": "Version",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(traces_span_metrics_calls_total{service_name=\"forge-sim\"}, service_version)",
          "refId": "v"
        },
        "definition": "label_values(traces_span_metrics_calls_total{service_name=\"forge-sim\"}, service_version)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "span",
        "label": "Span",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(traces_span_metrics_calls_total{service_name=\"forge-sim\"}, span_name)",
          "refId": "v"
        },
        "definition": "label_values(traces_span_metrics_calls_total{service_name=\"forge-sim\"}, span_name)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Static passes per priority step",
      "description": "GameAction.checkStaticAbilities calls per PhaseHandler.mainLoopStep. Each one clears and re-applies every continuous effect. A delta-based engine should push this toward the number of steps where something actually changed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(traces_span_metrics_calls_total{service_name=\"forge-sim\",service_version=~\"$version\",span_name=\"GameAction.checkStaticAbilities\"}[$__range])) / sum(increase(traces_span_metrics_calls_total{service_name=\"forge-sim\",service_version=~\"$version\",span_name=\"PhaseHandler.mainLoopStep\"}[$__range]))",
          "legendFormat": "__auto",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "State checks per priority step",
      "description": "GameAction.checkStateEffects calls per priority step. Each one runs up to 9 static passes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(traces_span_metrics_calls_total{service_name=\"forge-sim\",service_version=~\"$version\",span_name=\"GameAction.checkStateEffects\"}[$__range])) / sum(increase(traces_span_metrics_calls_total{service_name=\"forge-sim\",service_version=~\"$version\",span_name=\"PhaseHandler.mainLoopStep\"}[$__range]))",
          "legendFormat": "__auto",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      }
    },
    {
      "id": 3,
